       end

    30 function pkg.safe_enable(ssid, password, encryption, radio)
           -- Enables the hotpost client only if the hotpost is already available
           -- in order to avoid clients from ap interfaces to be kicked out.
    10     local encryption = encryption or pkg.DEFAULT_ENCRYPTION
    10     local ssid = ssid or pkg.DEFAULT_SSID
    10     local radio = radio or pkg.DEFAULT_RADIO

    10     local is_safe, reason = pkg._is_safe(ssid, encryption, radio)
