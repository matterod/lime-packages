     5 local libuci = require("uci")

     5 wan = {}

     5 wan.configured = false

    10 function wan.configure(args)
     5 	if wan.configured then return end
     5 	wan.configured = true

     5 	local uci = libuci:cursor()
     5 	uci:set("network", "wan", "interface")
     5 	uci:set("network", "wan", "proto", "dhcp")
     5 	uci:save("network")
       end

    10 function wan.setup_interface(ifname, args)
     5 	local uci = libuci:cursor()
     5 	uci:set("network", "wan", "device", ifname)
     5 	uci:save("network")

       	--! Accepting link local traffic also on WAN should not cause hazards.
       	--! It is very helpful in cases where the devices have problem to the other
       	--! ports, to have at least an addictional way to enter for rescue operation
     5 	local ALLOW_WAN_LL_SECT = "lime_allow_wan_all_link_local"
     5 	uci:set("firewall", ALLOW_WAN_LL_SECT, "rule")
     5 	uci:set("firewall", ALLOW_WAN_LL_SECT, "name", ALLOW_WAN_LL_SECT)
     5 	uci:set("firewall", ALLOW_WAN_LL_SECT, "src", "wan")
     5 	uci:set("firewall", ALLOW_WAN_LL_SECT, "family", "ipv6")
     5 	uci:set("firewall", ALLOW_WAN_LL_SECT, "src_ip", "fe80::/10")
     5 	uci:set("firewall", ALLOW_WAN_LL_SECT, "dest_ip", "fe80::/10")
     5 	uci:set("firewall", ALLOW_WAN_LL_SECT, "target", "ACCEPT")
     5 	uci:save("firewall")
       end

     5 return wan

