   110 	uci:foreach("network", "device",
       		function(s)
    35 			if br_lan_section then return end
    35 			local dev_type = uci:get("network", s[".name"], "type")
    35 			local dev_name = uci:get("network", s[".name"], "name")
    35 			if not (dev_type == 'bridge') then return end
    35 			if not (dev_name == 'br-lan') then return end
    35 			br_lan_section = s[".name"]
