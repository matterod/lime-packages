    20 local utils = require 'lime.utils'


    20 local TMATE_SOCK = "/tmp/tmate.sock"
    20 local TMATE_CONFIG = "/etc/tmate/tmate.conf"

    20 local tmate = {}

    20 function tmate.cmd_as_str(cmd)
*****0    final_cmd = "tmate -f "..TMATE_CONFIG.." -S "..TMATE_SOCK.." "..cmd
*****0    return utils.unsafe_shell(final_cmd)
       end

       local function unix_socket_listening(name)
    10    return "" ~= utils.unsafe_shell("netstat -xl | grep "..TMATE_SOCK.." 2>/dev/null")
       end

    20 function tmate.session_running()
    10   return unix_socket_listening(TMATE_SOCK)
       end

    20 function tmate.get_rw_session()
    30   return tmate.cmd_as_str("display -p '#{tmate_ssh}'"):sub(1, -2)
       end

    20 function tmate.get_ro_session()
    30   return tmate.cmd_as_str("display -p '#{tmate_ssh_ro}'"):sub(1, -2)
       end

    20 function tmate.get_connected_clients()
    20   return tmate.cmd_as_str("display -p '#{tmate_num_clients}'"):sub(1, -2)
       end

    20 function tmate.open_session()
    30   tmate.cmd_as_str("new-session -d")
    30   tmate.cmd_as_str("send-keys C-c")
       end

    20 function tmate.wait_session_ready()
    30   tmate.cmd_as_str("wait tmate-ready")
       end

    20 function tmate.close_session()
    30   tmate.cmd_as_str("kill-session -t 0")
       end

    20 return tmate

