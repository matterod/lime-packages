    75 		local radioOptions = specificRadios[radioName] or {}
    75 		local bandOptions = config.get_all(radioBand) or {}
    75 		local options = config.get_all("wifi")
       		
    75 		options = utils.tableMelt(options, bandOptions)
    75 		options = utils.tableMelt(options, radioOptions)

       		--! If manual mode is used toghether with other modes it results in an
       		--! unpredictable behaviour
    75 		if options["modes"][1] ~= "manual" then
       			--! fallback to "auto" in client mode
       			local channel
    75 			if options["modes"][1] ~= "client" then
    65 				channel = options["channel"]
    65 				if type(channel) == "table" then
    30 					channel = channel[1 + radio.per_band_index % #channel]
       				end
       			else
    10 				channel = options["channel"] or "auto"
       			end

    75 			local uci = config.get_uci_cursor()
    75 			uci:set("wireless", radioName, "disabled", 0)
    75 			uci:set("wireless", radioName, "distance", options["distance"])
    75 			uci:set("wireless", radioName, "noscan", 1)
    75 			uci:set("wireless", radioName, "channel", channel)
    75 			if options["country"] then uci:set("wireless", radioName, "country", options["country"]) end
    75 			if options["legacy_rates"] and not wireless.is5Ghz(radioName) then uci:set("wireless", radioName, "legacy_rates", options["legacy_rates"]) end
    75 			if options["txpower"] then uci:set("wireless", radioName, "txpower", options["txpower"]) end
    75 			if options["htmode"] then uci:set("wireless", radioName, "htmode", options["htmode"]) end
    75 			uci:save("wireless")

   180 			for _,modeName in pairs(options["modes"]) do
   105 				local args = {}
   105 				local mode = require("lime.mode."..modeName)

       				-- gather mode specific configs (eg ieee80211s_mcast_rate_5ghz)
  1355 				for key,value in pairs(options) do
  1250 					local keyPrefix = utils.split(key, "_")[1]
  1250 					local isGoodOption = ( (key ~= "modes")
  1145 					                and (not key:match("^%."))
  1145 					                and (not key:match("channel"))
   810 					                and (not key:match("country"))
   715 					                and (not key:match("legacy_rates"))
   695 					                and (not key:match("txpower"))
   695 					                and (not key:match("htmode"))
   675 					                and (not key:match("distance"))
   630 					                and (not key:match("unstuck_interval"))
   525 					                and (not key:match("unstuck_timeout"))
  1250 					                and (not (wireless.isMode(keyPrefix) and keyPrefix ~= modeName)))
  1250 					if isGoodOption then
   150 						local nk = key:gsub("^"..modeName.."_", "")
   150 						if nk == "ssid" then
    40 							value = wireless.resolve_ssid(value)
       						end
   150 						args[nk] = value
       					end
       				end

   105 				mode.setup_radio(radio, args)
       			end
       		end
       	end
       end

