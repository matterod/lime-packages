       #!/usr/bin/lua

    48 local config = require("lime.config")
    48 local utils = require("lime.utils")

    48 gen_cfg = {}

    48 gen_cfg.ASSET_BASE_DIR = '/etc/lime-assets/'
    48 gen_cfg.NODE_ASSET_DIRNAME = 'node/'
    48 gen_cfg.COMMUNITY_ASSET_DIRNAME = 'community/'
    48 gen_cfg.CONFIG_FIRST_BOOT_SIGNAL_FILE = '/etc/.cfg_first_boot_already_run'
    48 gen_cfg.RUN_ASSET_AT_FIRSTBOOT = 'ATFIRSTBOOT'
    48 gen_cfg.RUN_ASSET_AT_CONFIG = 'ATCONFIG'

    96 function gen_cfg.clean()
           -- nothing to clean, but needs to be declared to comply with the API
       end

    96 function gen_cfg.configure()
     5     gen_cfg.do_generic_uci_configs()
     5     gen_cfg.do_copy_assets()
     5     if not utils.file_exists(gen_cfg.CONFIG_FIRST_BOOT_SIGNAL_FILE) then
     5         gen_cfg.do_run_assets(gen_cfg.RUN_ASSET_AT_FIRSTBOOT)
     5         utils.write_file(gen_cfg.CONFIG_FIRST_BOOT_SIGNAL_FILE, '')
           end
     5     gen_cfg.do_run_assets(gen_cfg.RUN_ASSET_AT_CONFIG)
       end


       --! Generic UCI configuration from libremesh. Eg usage:
       --!   config generic_uci_config libremap
       --!     list uci_set "libremap.settings=libremap"
       --!     list uci_set "libremap.settings.community=our.libre.org"
       --!     list uci_set "libremap.settings.community_lat=-200.123"
       --!     list uci_set "libremap.settings.community_lon=500.9"
    96 function gen_cfg.do_generic_uci_configs()
    35     local uci = config.get_uci_cursor()
    35     local ok = true
    35     utils.log("Applying generic configs:")
    70     config.foreach("generic_uci_config", function(gen_uci_cfg)
    35         utils.log(" " .. gen_uci_cfg[".name"])
   120         for _, v in pairs(gen_uci_cfg["uci_set"]) do
    85             if uci:set(v) ~= true then
    20                 utils.log(" Error on generic config uci_set: %s", v)
    20                 ok = false
                   end
               end
           end)
    35     config.uci_commit_all()
    35     utils.log("Done applying generic configs.")
    35     return ok
       end

    96 function gen_cfg.get_asset(asset)
    50     if (utils.stringStarts(asset, gen_cfg.NODE_ASSET_DIRNAME) or
    30         utils.stringStarts(asset, gen_cfg.COMMUNITY_ASSET_DIRNAME)) then
    40         local asset = gen_cfg.ASSET_BASE_DIR .. asset
    40         if utils.file_exists(asset) then
    30             return asset
               end
           end
       end

       --! copy_asset copy an file from the assets directory into a specified path.
       --! The node asset directories are /etc/lime-assets/node and /etc/lime-assets/community.
       --! The community directory should contain the same files in all the community nodes.
       --!
       --! config copy_asset collectd
       --!    option asset 'community/collectd.conf' # or 'node/collectd.conf' or 'community/mynode_collectd.conf'
       --!    option dst '/etc/collectd.conf'
       --!

    96 function gen_cfg.do_copy_assets()
    25     local uci = config.get_uci_cursor()
    25     local ok = true
    25     utils.log("Copying assets:")
    50     config.foreach("copy_asset", function(copy_asset)
    20         local asset = copy_asset["asset"]
    20         utils.log("  %s (%s)", copy_asset[".name"], asset)
    20         local dst = copy_asset["dst"]
    20         local src = gen_cfg.get_asset(asset)
    20         if src ~= nil then
    10             local dst_dirname = dst:match("(.*/)")
    10             if not utils.file_exists(dst_dirname) then
*****0                 os.execute("mkdir -p " .. utils.shell_quote(dst_dirname))
                   end

    10             src = utils.shell_quote(src)
    10             dst = utils.shell_quote(dst)
    10             os.execute('cp -dpf ' .. src .. ' ' .. dst)
               else
    10             utils.log(" Error copying asset '%s': file not found.", asset)
    10             ok = false
               end
           end)
    25     utils.log("Done copying assets.")
    25     return ok
       end

       --! Executes a file from the assets directory scheme explained in copy_asset.
       --!
       --! config run_asset dropbear
       --!     option asset 'community/dropbear.sh'
       --!     option when 'ATFIRSTBOOT' # ATFIRSTBOOT, ATCONFIG
       --!
    96 function gen_cfg.do_run_assets(when)
    40     local uci = config.get_uci_cursor()
    40     local ok = true
    40     utils.log("Running assets on " .. when .. " :")
    80     config.foreach("run_asset", function(run_asset)
    30         local asset = run_asset["asset"]
    30         if run_asset["when"] == when then
    30             utils.log("  %s (%s)", run_asset[".name"], asset)
    30             local src = gen_cfg.get_asset(asset)
    30             if src ~= nil then
    20                 local retval = os.execute("chmod +x " .. src .. "; " .. src)
    20                 if retval ~= 0 then
    10                     utils.log(" Warning: the asset '%s': returnen non zero status.", src)
    10                     ok = false
                       end
                   else
    10                 utils.log(" Error running asset '%s': file not found .", asset)
    10                 ok = false
                   end
               end
           end)
    40     utils.log("Done running assets.")
    40     return ok
       end


    48 return gen_cfg

