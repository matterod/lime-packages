   100         for key, value in pairs(babelneigt_obj.IPv6) do
    80             local key_table = {(string.gsub(get_interface_ip(value.dev),":","")),(string.gsub(key,":",""))}
    80 		    table.sort(key_table)
    80 		    links[table.concat(key_table)]= {
    80                 src_ip = get_interface_ip(value.dev),
    80                 dst_ip = key,
    80                 iface = value.dev
    80             }
               end
           end
    20     return links
       end

    10 shared_state_links_info.insert_in_ss_with_location(get_babel_links_info(),"babel_links_info")

