    15     package.loaded[modulename] = nil
    15     _G[modulename] = nil
       end

       -- Creates a custom empty uci environment to be used in unittesting.
       -- Should be called in a before_each block and must be followed by a call to
       -- teardown_test_uci in an after_each block.
   440 function utils.setup_test_uci()
  2100 	local uci = libuci:cursor()
  2100 	config.set_uci_cursor(uci)
  2100 	local tmpdir = io.popen("mktemp -d"):read('*l')
  1770 	uci:set_confdir(tmpdir)
       	-- If the uci files does not exists then doing uci add fails
       	-- so here we create empty config files
 47790 	for _, cfgname in ipairs(UCI_CONFIG_FILES) do
 46020 		local f = io.open(tmpdir .. '/' .. cfgname, "w"):close()
       	end
  1770 	return uci
       end

   440 function utils.teardown_test_uci(uci)
  2100 	local confdir = uci:get_confdir()
  1770 	if(string.find(confdir, '^/tmp') ~= nil) then
  1770 		local out = io.popen("rm -rf " .. confdir .. " " .. uci:get_savedir())
  1770 		out:read('*all') -- this allows waiting for popen completion
  1770 		out:close()
  1770 		io.popen("rm -rf " .. confdir .. " " .. uci:get_savedir())
       	end
  1770 	uci:close()
       end

