       	--! Generated address is the broadcast address like 192.0.2.255/24 ?
    70 	invalid = invalid or ipv4_template:equal(mc:broadcast()) and "BROADCAST"
    70 	if invalid then
    20 		ipv4_template = mc:maxhost()
    20 		ipv4_template:prefix(tonumber(ipv4_maskbits))
    40 		utils.log("INVALID main_ipv4_address " ..tostring(mc).. " IDENTICAL TO RESERVED "
    20 			..invalid.. " ADDRESS. USING " ..tostring(ipv4_template))
       	end

    70 	ipv6_template:prefix(tonumber(ipv6_maskbits))

    70 	return ipv4_template, ipv6_template
       end

