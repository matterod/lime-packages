    13 local node_status = require("lime.node_status")
    13 local network = require("lime.network")
    13 local iwinfo = require ("iwinfo")
    13 local shared_state_links_info = require ("shared_state_links_info")

    13 local data_type_name = "wifi_links_info"

    13 function get_wifi_links_info()
    47     local stations = node_status.get_stations()
    47     local links = {}
   115     for _, station in ipairs(stations) do
    68         macparts = network.get_mac(station.iface)
    68         src_macaddr = string.lower(table.concat(macparts, ":"))
    68         local station_stats = node_status.get_station_stats(station)
    68         local freq = iwinfo.nl80211.frequency(station.iface)
    68         local chanenel = iwinfo.nl80211.channel(station.iface)
    68         local key_table = {string.lower(string.gsub(src_macaddr, ":", "")),
    68                            string.lower(string.gsub(station.station_mac, ":", ""))}
    68         table.sort(key_table)
    68         links[table.concat(key_table)] = {
    68             src_mac = src_macaddr,
    68             dst_mac = string.lower(station.station_mac),
    68             signal = station_stats.signal,
    68             chains = station_stats.chains,
    68             iface = station.iface,
    68             rx_rate = station_stats.rx_rate,
    68             tx_rate = station_stats.tx_rate,
    68             freq = freq,
    68             channel = chanenel,
                   --dst_loc = {lat="FIXME",long="FIXME"} --if no location is found later no dst location will be informed
    68         }
           end
    47     return links
       end

    13 shared_state_links_info.insert_in_ss_with_location(get_wifi_links_info(),data_type_name)

