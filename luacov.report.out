    36 local JSON = require("luci.jsonc")
    36 local location = require 'lime.location'

    36 local shared_state_links_info = {}

    36 function shared_state_links_info.add_dst_loc(links_info, shared_state_sample, hostname)
    52     if shared_state_sample ~= nil then
    48         for link, l_data in pairs(links_info.links) do
    96             for node, data in pairs(shared_state_sample) do
    64                 if node ~= hostname and data.links ~= nil then
    16                     local link_data = data.links[link]
    16                     if link_data ~= nil and data.src_loc~= nil then
     8                         l_data.dst_loc = {}
     8                         l_data.dst_loc.lat = data.src_loc.lat
     8                         l_data.dst_loc.long = data.src_loc.long
                           end
                       end
                   end
               end
           end
       end

    36 function shared_state_links_info.add_own_location_to_links(links)
    70 return {
    70     links = links,
           -- we are not interested in the community location.
    70     src_loc = location.get_node() or { 
    70         lat = "FIXME",
    70         long = "FIXME"
    70     }
    70 }
       end

    36 function shared_state_links_info.insert_in_ss_with_location(links,data_type_name)
    36     local hostname = io.input("/proc/sys/kernel/hostname"):read("*line")
    36     local links_info = shared_state_links_info.add_own_location_to_links(links)
    36     local shared_state_sample = JSON.parse(io.popen("shared-state-async get "..data_type_name, "r"):read('*all'))
    36     shared_state_links_info.add_dst_loc(links_info, shared_state_sample, hostname)
    36     local result = {[hostname] = links_info}
    36     io.popen("shared-state-async insert "..data_type_name, "w"):write(JSON.stringify(result))
       end

    36 return shared_state_links_info

