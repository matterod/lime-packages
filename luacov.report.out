    18 local hardware_detection = require("lime.hardware_detection")
    18 local config = require("lime.config")
    18 local utils = require("lime.utils")

    18 local openwrt_wan = {}

    18 openwrt_wan.sectionName = hardware_detection.sectionNamePrefix.."openwrt_wan"

    18 function openwrt_wan.clean()
     5 	if config.autogenerable(openwrt_wan.sectionName) then
     5 		config.delete(openwrt_wan.sectionName)
       	end
       end

    18 function openwrt_wan.detect_hardware()
    35 	if config.autogenerable(openwrt_wan.sectionName) then
       		local ifname
    35 		local board = utils.getBoardAsTable()
    35 		local networkTable = board['network']
    35 		if networkTable then
    25 			local wanTable = networkTable['wan']
    25 			if wanTable then
    15 				ifname = wanTable['device']
       			end
       		end
    35 		if ifname and ifname ~= "" then
    15 			local protos = {}
    15 			local net = require("lime.network")
    15 			local utils = require("lime.utils")
    75 			for _, pArgs in pairs(config.get("network", "protocols")) do
    60 				local pArr = utils.split(pArgs, net.protoParamsSeparator)
    60 				if ( pArr[1] == "bmx6" or pArr[1] == "bmx7") then
    10 					pArr[2] = 0
    10 					pArgs = table.concat(pArr, net.protoParamsSeparator)
    10 					table.insert(protos, pArgs)
    50 				elseif ( pArr[1]~="lan" and pArr[1]~="wan" ) then
    35 					table.insert(protos, pArgs)
       				end
       			end
    15 			table.insert(protos, "wan")

    15 			config.init_batch()
    15 			config.set(openwrt_wan.sectionName, "net")
    15 			config.set(openwrt_wan.sectionName, "autogenerated", "true")
    15 			config.set(openwrt_wan.sectionName, "protocols", protos)
    15 			config.set(openwrt_wan.sectionName, "linux_name", ifname)
    15 			config.end_batch()

    15 			utils.dbg("WAN interface:", ifname)
       		else
    20 			utils.dbg("WAN interface not found")
       		end
       	end
       end

    18 return openwrt_wan

