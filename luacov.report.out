    10 local utils = require "lime.utils"
    10 local config = require "lime.config"

    10 local defreboot = {}

    10 defreboot.DEFAULT_REBOOT_UPTIME = 60*60*27
    10 defreboot.SLEEP_BEFORE_REBOOT_S = 30

    10 defreboot.POSTPONE_FILE_PATH = '/tmp/deferrable-reboot.defer'

    10 function defreboot.config(min_uptime)
   110 	if min_uptime == nil then
    40 		local uci = config.get_uci_cursor()
    40 		local lime_min_uptime = config.get("system", "deferrable_reboot_uptime_s", false)
    40 		local general_min_uptime = uci:get("deferrable-reboot", "options", "deferrable_reboot_uptime_s")
    40 		min_uptime = tonumber(lime_min_uptime or general_min_uptime or defreboot.DEFAULT_REBOOT_UPTIME)
       	end
   110 	assert(type(min_uptime) == "number", "min_uptime must be a number")
   110 	defreboot.min_uptime = min_uptime
       end

    10 function defreboot.should_reboot()
    70 	local uptime_s = utils.uptime_s()
    70 	local postpone_until_s = defreboot.read_postpone_file()
    70 	local min_uptime = defreboot.min_uptime

    70 	if (postpone_until_s ~= nil) and (postpone_until_s > min_uptime) then
    30 		min_uptime = postpone_until_s
       	end
    70 	return uptime_s > min_uptime
       end

    10 function defreboot.postpone_util_s(uptime)
    30 	assert(type(uptime) == "number", "uptime must be a number")
    30 	local f = io.open(defreboot.POSTPONE_FILE_PATH, 'w')
    30 	f:write(tostring(uptime))
    30 	f:close()
       end


       --! use this function to postpone the reboot, also the following command can be used
       --! replacing SECONDS: # awk '{print $1 + SECONDS}' /proc/uptime > /tmp/deferrable-reboot.defer
    10 function defreboot.read_postpone_file()
    70 	local f = io.open(defreboot.POSTPONE_FILE_PATH)
    70 	if f ~= nil then
    30 		return tonumber(f:read("*l"))
       	end
    40 	return nil
       end

    10 function defreboot.reboot()
       	--! give time to sysupgrade to kill us
*****0 	nixio.nanosleep(defreboot.SLEEP_BEFORE_REBOOT_S)
*****0 	os.execute("reboot")
       end

    10 return defreboot

