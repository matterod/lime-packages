    30     local uci = config.get_uci_cursor()
    30     local eth_role = uci:get("lime-node", tag_value, "eth_role")
           -- verify previous config
    30     if eth_role ~= nil then
*****0         if eth_role == role then
                   -- No changes needed, the role is already set
*****0             return true
               else
*****0             eht_config.delete_eth_config(tag_value)
               end
           end

           -- handle lm_hwd_openwrt_wan
    30     if role ~= "wan" then
               -- if the port was automatically configured as a wan port, we need to remove the
               -- wan protocol. If we returtn to default we need to enable auto detection.
    20         local switch_status = node_status.switch_status()
    20         if switch_status ~= nil then
   100             for _, status in ipairs(switch_status) do
    80                 if status.device == device and status.role == "wan" then
*****0                     if role == "lan" or role == "mesh" then
*****0                         uci:set("lime-node", "lm_hwd_openwrt_wan", "net")
*****0                         uci:set("lime-node", "lm_hwd_openwrt_wan", "autogenerated", "false")

*****0                     elseif role == "default" then
*****0                         uci:delete("lime-node", "lm_hwd_openwrt_wan")
                           end
                           break
                       end
                   end
               end
           end

    30     if role == "default" then
    10         eht_config.delete_eth_config(tag_value)
           else
    20         uci:set("lime-node", tag_value, "net")
    20         uci:set("lime-node", tag_value, "eth_role", role)
    20         uci:set("lime-node", tag_value, "linux_name", device)

    20         if role == "wan" then
    10             uci:set("lime-node", tag_value, "protocols", {"wan", "dynamic"})
    10         elseif role == "lan" then
*****0             uci:set("lime-node", tag_value, "protocols", {"lan"})
    10         elseif role == "mesh" then
    10             uci:set("lime-node", tag_value, "protocols", {"batadv:%N1", "babeld:17"})
               else
*****0             return false
               end
           end
    30     uci:commit("lime-node")
    30     config.uci:save("lime-node")
    30     os.execute("lime-config && /etc/init.d/network restart")
    30     return true
       end

