   105 	uci:set("wireless", wirelessInterfaceName, "device", radioName)
   105 	uci:set("wireless", wirelessInterfaceName, "ifname", ifname)
   105 	uci:set("wireless", wirelessInterfaceName, "network", networkInterfaceName)

   105 	if extras then
   285 		for key, value in pairs(extras) do
   180 			uci:set("wireless", wirelessInterfaceName, key, value)
