       #!/usr/bin/lua

       --! LibreMesh community mesh networks meta-firmware
       --!
       --! Copyright (C) 2014-2023  Gioacchino Mazzurco <gio@eigenlab.org>
       --! Copyright (C) 2023  Asociación Civil Altermundi <info@altermundi.net>
       --!
