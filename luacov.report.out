       #!/usr/bin/lua

    26 local fs = require("nixio.fs")
    26 local utils = require("lime.utils")


    26 local hardware_detection = {}

    26 hardware_detection.sectionNamePrefix = "lm_hwd_"
    26 hardware_detection.search_paths = {"/usr/lib/lua/lime/hwd/*.lua"}

       --! Hardware detection module clean()
       --! Call clean() from all installed submodules
    26 function hardware_detection.clean()
    15     for _,search_path in ipairs(hardware_detection.search_paths) do
    30         for hwd_module_path in fs.glob(search_path) do
    20             local module_name = "lime.hwd." .. fs.basename(hwd_module_path):sub(1,-5)
    20             if utils.isModuleAvailable(module_name) then
    20                 require(module_name).clean()
                   end
               end
           end
       end

       --! Hardware detection module configure()
       --! Call detect_hardware() from all installed submodules
    26 function hardware_detection.configure()
    15     for _,search_path in ipairs(hardware_detection.search_paths) do
    30         for hwd_module_path in fs.glob(search_path) do
    20             local module_name = "lime.hwd." .. fs.basename(hwd_module_path):sub(1,-5)
    20             if utils.isModuleAvailable(module_name) then
    20                 require(module_name).detect_hardware()
                   end
               end
       	end
       end


    26 return hardware_detection

