    60     local lat = uci:get("location", "settings", "community_latitude")
    60     local long = uci:get("location", "settings", "community_longitude")

    60     if location.is_valid_coordinate(lat) and location.is_valid_coordinate(long) then
    15         return {lat=lat, long=long}
