    10 local shared_state = require("shared-state")
    10 local utils = require("lime.utils")
    10 local config = require("lime.config")

    10 local network_nodes = {}

    10 function network_nodes._node(hostname, member, fw_version, board, ipv4, ipv6)
   260     return {hostname=hostname, member=member, fw_version=fw_version, board=board, ipv4=ipv4, ipv6=ipv6}
       end

    10 function network_nodes._serialize_for_network_nodes(node)
   100     return {hostname=node.hostname, member=node.member, fw_version=node.fw_version, board=node.board,
   100             ipv4=node.ipv4, ipv6=node.ipv6}
       end

    10 function network_nodes._deserialize_from_network_nodes(data)
   170     return network_nodes._node(data.hostname, data.member, data.fw_version, data.board, data.ipv4, data.ipv6)
       end

    10 function network_nodes._nodes_from_db(db)
    60     local nodes = {}
   220     for hostname, value in pairs(db:get()) do
   160         nodes[hostname] = network_nodes._deserialize_from_network_nodes(value.data)
           end
    60     return nodes
       end

    10 function network_nodes._create_node()
    20     local uci = config.get_uci_cursor()

    20     local hostname = utils.hostname()
    20     local fw_version = utils.release_info()['DISTRIB_RELEASE']
    20     local board = utils.current_board()
    20     local member = true
    20     local ipv4 = uci:get("network", "lan", "ipaddr")
    20     local ipv6 = uci:get("network", "lan", "ip6addr")
    20     if ipv6 then ipv6 = ipv6:gsub("/.*$", "") end -- remove the netmask info
    20     local node = network_nodes._node(hostname, member, fw_version, board, ipv4, ipv6)
    20     node.status = "recently_reachable"

    20     return node
       end

       --! Public API

    10 function network_nodes.get_nodes()
    40     local network_nodes_db = shared_state.SharedStateMultiWriter:new("network_nodes")
    40     local node_and_links_db = shared_state.SharedState:new("nodes_and_links")

    40     local nodes = {}
           -- augment the node information from the network_nodes and the 'nodes_and_links' dbs
   140     for hostname, node in pairs(network_nodes._nodes_from_db(network_nodes_db)) do
   100         if node_and_links_db:get()[hostname] then
    20             node.status = "recently_reachable"
    80         elseif node.member then
    60             node.status = "unreachable"
               else
    20             node.status = "gone"
               end
   100         nodes[hostname] = node
           end
    40     return nodes
       end

    10 function network_nodes.as_human_readable_table()
    10     local nodes = network_nodes.get_nodes()
    10     local tmpl = "%-26s %-16s %-30s %-20s %-30s %-40s\n"
    10     local out = string.format(tmpl, "hostname", "ipv4", "ipv6", "status", "board", "fw_version")
    40     for _, node in pairs(nodes) do
    30         if node.member then
    60             out = out .. string.format(tmpl, node.hostname, node.ipv4, node.ipv6, node.status,
    60                                        node.board, node.fw_version)
               end
           end
    10     return out
       end

    10 function network_nodes.publish()
    10     local node = network_nodes._create_node()
    10     local data = {
    10         [node.hostname] = network_nodes._serialize_for_network_nodes(node)
           }
    10     network_nodes_db = shared_state.SharedStateMultiWriter:new("network_nodes")
    10     network_nodes_db:insert(data)
       end

    10 function network_nodes.mark_nodes_as_gone(hostnames)
    10     local network_nodes_db = shared_state.SharedStateMultiWriter:new("network_nodes")
    10     local nodes = network_nodes._nodes_from_db(network_nodes_db)
    10     local data = {}
    30     for _, hostname in pairs(hostnames or {}) do
    20         local node = nodes[hostname]
    20         if node then
    20             node.member = false
    20             data[hostname] = network_nodes._serialize_for_network_nodes(node)
               end
           end
    10     network_nodes_db:insert(data)
       end

    10 return network_nodes

