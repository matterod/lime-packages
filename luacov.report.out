       #!/usr/bin/lua
    20 local utils = require('voucher.utils')
    20 local portal = require('portal.portal')
    20 local config = require('lime.config')


    20 local uci_cursor = config.get_uci_cursor()

    20 function handle_request (env)
    20   local method = 'http://'
    20   local origin_url = utils.urlencode(method .. env.HTTP_HOST .. env.REQUEST_URI)
    20   local portal_domain = uci_cursor:get("pirania", "base_config", "portal_domain")
    20   local with_vouchers = portal.get_config().with_vouchers
    20   local redirect_path = ''
    20   if with_vouchers then
    10     redirect_path = uci_cursor:get("pirania", "base_config", "url_auth")
         else
    10     redirect_path = uci_cursor:get("pirania", "read_for_access", "url_portal")
         end
    20   local redirect_url = method .. portal_domain .. redirect_path .. "?prev=" .. origin_url
         
    20   uhttpd.send("Status: 302 \r\n")
    20   uhttpd.send("Location: " .. redirect_url .. "\r\n")
    20   uhttpd.send("\r\n") --! indicate uhttpd to send the response
       end

