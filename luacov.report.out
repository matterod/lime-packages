    60 local eth_config = require("lime-eth-config")


       local function get_eth_config(msg)
           
    30     interfaces = eth_config.get_eth_config()

    30     result = {}
    30     if interfaces and #interfaces > 0 then
    30       result.status = "ok"
    30       result.interfaces = interfaces
           else
*****0       result.status = "error"  
*****0       result.interfaces = {}
*****0       result.error = "No interface configuration found"
           end
    30     utils.printJson(result)
       end

    60 function set_eth_config(msg)
    30   local device, role = msg.device, msg.role

    30   if not device or not role then
*****0     return utils.printJson({ status = "error", error = "Missing parameters" })
         end

    30   local success = eth_config.set_eth_config(device, role)
    30   if success then
    30     utils.printJson({ status = "ok" })
         else
*****0     utils.printJson({ status = "error", error = "Failed to set eth ".. msg.device .. " as " .. msg.role  })
         end

       end

    60 local methods = {
    60   get_eth_config = { no_params = 0 },
    60   set_eth_config = { device = 'value', role = 'value'}
       }


    60 if arg[1] == 'list' then
*****0     utils.printJson(methods)
       end

    60 if arg[1] == 'call' then
    60     local msg = utils.rpcd_readline() or '{}'
    60     msg = json.parse(msg)
    60     if  arg[2] == 'get_eth_config' then get_eth_config(msg)
    30     elseif arg[2] == 'set_eth_config' then set_eth_config(msg)
*****0     else utils.printJson({ error = "Method not found" })
           end
       end

