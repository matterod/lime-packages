   434 function network.primary_address(offset)
    70 	local offset = offset or 0
    70 	local pm = network.primary_mac()
    70 	local ipv4_template = config.get("network", "main_ipv4_address")
    70 	local ipv6_template = config.get("network", "main_ipv6_address")

    70 	local ipv4_maskbits = ipv4_template:match("[^/]+/(%d+)")
    70 	ipv4_template = ipv4_template:gsub("/%d-/","/")
    70 	local ipv6_maskbits = ipv6_template:match("[^/]+/(%d+)")
