       local function get_node_ap_data(is_admin)
    25     local result = {}
    25     local cfg = wireless.get_band_config(wireless_service.AP_BAND)
    25     result.enabled = utils.has_value(cfg.modes, 'apname')
    25     result.has_password = (cfg.apname_encryption and
    25                           cfg.apname_encryption ~= "none")
    25     result.password = is_admin and cfg.apname_key or nil
    25     result.ssid = wireless.resolve_ssid(cfg.apname_ssid)
    25     return result
       end

       local function get_community_ap_data()
    25     local result = {}
    25     local cfg = wireless.get_band_config(wireless_service.AP_BAND)
    25     local community_cfg = wireless.get_community_band_config(wireless_service.AP_BAND)
    25     result.enabled = utils.has_value(cfg.modes, 'ap')
    25     result.ssid = wireless.resolve_ssid(cfg.ap_ssid)
    25     result.community = {}
    25     result.community.enabled = utils.has_value(community_cfg.modes, 'ap')
    25     return result
       end

    20 function wireless_service.get_access_points_data(is_admin)
    25     local result = {}
    25     result.node_ap = get_node_ap_data(is_admin)
    25     result.community_ap = get_community_ap_data()
    25     return result
       end

    20 function wireless_service.set_node_ap(has_password, password)
    10     local config = {}
    10     config.apname_encryption = has_password and 'psk2' or 'none'
    10     config.apname_key = password or nil
    10     wireless.set_band_config(wireless_service.AP_BAND, config)
       end

    20 function wireless_service.set_community_ap(enabled)
    10     if enabled then
     5         wireless.add_band_mode(wireless_service.AP_BAND, 'ap')
           else
     5         wireless.remove_band_mode(wireless_service.AP_BAND, 'ap')
           end
       end

    20 return wireless_service

