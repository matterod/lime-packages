    10     uci:set(config.UCI_NODE_NAME, pkg.GENERIC_SECTION_NAME, "generic_uci_config")
    20     uci:set(config.UCI_NODE_NAME, pkg.GENERIC_SECTION_NAME, "uci_set", {
    10         "wireless." .. radio .. ".disabled=0",
    10         "wireless." .. radio .. ".channel=auto",
    10         "wireless." .. pkg.IFACE_SECTION_NAME .. "=wifi-iface",
    10         "wireless." .. pkg.IFACE_SECTION_NAME .. ".device=" .. radio,
    10         "wireless." .. pkg.IFACE_SECTION_NAME .. ".network=" .. pkg.IFACE_SECTION_NAME,
    10         "wireless." .. pkg.IFACE_SECTION_NAME .. ".mode=sta",
    10         "wireless." .. pkg.IFACE_SECTION_NAME .. ".ifname=" .. pkg.IFACE_NAME,
    10         "wireless." .. pkg.IFACE_SECTION_NAME .. ".ssid=" .. ssid,
    10         "wireless." .. pkg.IFACE_SECTION_NAME .. ".encryption=" .. encryption,
    10         "wireless." .. pkg.IFACE_SECTION_NAME .. ".key=" .. password,
    10         "network." .. pkg.IFACE_SECTION_NAME .. "=interface",
    10         "network." .. pkg.IFACE_SECTION_NAME .. ".proto=dhcp",
    10         }
           )
    10     uci:commit(config.UCI_NODE_NAME)
    10     pkg._apply_change()
