    70 	ipv4_template = utils.applyMacTemplate10(ipv4_template, pm)
    70 	ipv6_template = utils.applyMacTemplate16(ipv6_template, pm)

    70 	ipv4_template = utils.applyNetTemplate10(ipv4_template)
    70 	ipv6_template = utils.applyNetTemplate16(ipv6_template)

    70 	local m4, m5, m6 = tonumber(pm[4], 16), tonumber(pm[5], 16), tonumber(pm[6], 16)
    70 	local hexsuffix = utils.hex((m4 * 256*256 + m5 * 256 + m6) + offset)
    70 	ipv4_template = network.generate_host(ip.IPv4(ipv4_template), hexsuffix)
    70 	ipv6_template = network.generate_host(ip.IPv6(ipv6_template), hexsuffix)

    70 	ipv4_template:prefix(tonumber(ipv4_maskbits))
    70 	local mc = ipv4_template
