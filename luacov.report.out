    10 local JSON = require("luci.jsonc")
    10 local network = require ("lime.network")
    10 local location = require("lime.location")
    10 local utils = require('lime.utils')
    10 local config = require("lime.config")

    10 local hostname = utils.hostname()
    10 function get_node_info()
    20 	local uci = config.get_uci_cursor()
    20 	local coords = location.get_node() or location.get_community() or
    20 	{lat="FIXME", long="FIXME"}
    20 	local fw_version =  "no version"
    40 	pcall(function () fw_version = utils.release_info()['DISTRIB_RELEASE'] end)
    20 	local board = "no board"
    40 	pcall(function () board = utils.current_board() end)
    20 	local ipv4 = uci:get("network", "lan", "ipaddr")
    20 	local ipv6 = uci:get("network", "lan", "ip6addr")
    20 	if ipv6 then ipv6 = ipv6:gsub("/.*$", "") end
    20 	local uptime = utils.uptime_s()
    20 	local macs =  network.get_own_macs("*")
    20 	return {hostname=hostname, firmware_version=fw_version, board=board,
    20 	 ipv4=ipv4, ipv6=ipv6,coordinates=coords,macs= macs,uptime = uptime,
    20 	 device = "Router" }
       end

    10 local result = { [hostname] = get_node_info() }
    10 io.popen("shared-state-async insert node_info", "w"):write(JSON.stringify(result))

