    15 local config = require "lime.config"
    15 local utils = require "lime.utils"
    15 local iwinfo = require "iwinfo"
    15 local nixio = require 'nixio'
    15 local wu = {}

       -- so we always scan in at least one different frequency
    15 wu.FREQ_2GHZ_LIST = "2412 2462"
    15 wu.FREQ_5GHZ_LIST = "5180 5240"

       -- if iw runs for 5 min, it is likely hanging
    15 wu.TIMEOUT = tonumber( config.get("wifi", "unstuck_timeout", 300 ))

    15 function wu.get_stickable_ifaces()
    15 	local uci = config.get_uci_cursor()
    15 	local ifaces = {}
    15 	local devices = {}

    30 	uci:foreach("wireless", "wifi-iface", function(entry)
    75 			if (entry.mode == 'mesh' or entry.mode == 'adhoc' or
    30 				entry.mode == 'sta' or entry.mode == 'ap') then
    75 				local device_path = uci:get("wireless", entry.device, "path")
    75 				local device_disabled = uci:get("wireless", entry.device, "disabled")
       				--! get only one interface per radio and check that the radio is not disabled
    75 				if device_path and device_disabled == '0' and devices[device_path] == nil then
    45 					table.insert(ifaces, entry.ifname)
    45 					devices[device_path] = 1
       				end
       			end
       		end)
    15 	return ifaces
       end

    15 function wu.wait_and_kill_on_timeout(pid_time_started)
    10 	local pid_done = {}

    20 	for pid,time_started in pairs(pid_time_started) do
    10 		pid_done[pid]=false
       	end

       	repeat
       		-- wait for 100ms
  1505 		nixio.nanosleep(0,100e6)

       		-- see if something changed
       		while true do
  1525 			pid,state,code = nixio.waitpid(nil,"nohang")
  1525 			if not pid then break end
    20 			if pid == 0 then break end
    20 			pid_done[pid] = true
       		end

       		-- see if time is up
  1505 		now = os.time()
  4505 		for pid,time_started in pairs(pid_time_started) do
  3000 			time_is_up = now - time_started > wu.TIMEOUT
  3000 			if not pid_done[pid] and time_is_up then
       				-- time is up. send SIGTERM
     5 				nixio.kill(pid,15)
       				-- we don't care any longer about processes we signaled
     5 				pid_done[pid] = true
       			end
       		end

       		-- see if there are remaining processes
  1505 		all_done = true
  4520 		for pid,done in pairs(pid_done) do
  3015 			all_done = all_done and done
       		end
  1505 	until all_done

       end

    15 function wu.do_workaround()
    10 	local ifaces = wu.get_stickable_ifaces()
    10 	local pid_time_started = {}

    40 	for _, iface in pairs(ifaces) do
    30 		local cmd = "iw dev " .. iface .. " scan freq "
    30 		local freq = iwinfo.nl80211.frequency(iface)
    30 		if freq ~= nil then
    20 			if freq < 3000 then
    10 				cmd = cmd .. wu.FREQ_2GHZ_LIST
       			else
    10 				cmd = cmd .. wu.FREQ_5GHZ_LIST
       			end
    20 			utils.log(cmd)

       			-- we can not use os.popen here, because it does not give us the
       			-- pid
    20 			pid = nixio.fork()
    20 			if pid == 0 then
    10 				nixio.exec('/bin/sh','-c',cmd..' >/dev/null')
    10 				os.exit(1)
       			else
    10 				pid_time_started[pid] = os.time()
       			end

    20 			nixio.nanosleep(1)
       		end
       	end

    10 	wu.wait_and_kill_on_timeout(pid_time_started)
       end

    15 function wu.configure()
     5 	interval = tonumber( config.get("wifi", "unstuck_interval", -1) )                                  
                                                                                                                  
     5 	if interval and interval > 0 then                                                                  
       		--! use sed to replace interval in /etc/crontabs/root                                      
    10 		io.popen("sed -i 's/\\*\\/\\d\\+ \\* \\* \\* \\* ((wifi-unstuck &> \\/dev\\/"..            
     5 			"null)&)/*\\/"..interval.." * * * * ((wifi-unstuck \\&> \\/dev\\/null)\\&)/g"..            
     5 			"' /etc/crontabs/root")                                                               
       	end
       end

    15 function wu.clean()
           -- nothing to clean, but needs to be declared to comply with the API
       end

    15 return wu

