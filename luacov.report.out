       #!/usr/bin/lua

    30 local JSON = require("luci.jsonc")
    30 local CRDT = "odhcpd-leases"


    30 local handle = io.popen("ubus call dhcp ipv4leases '{}' 2>/dev/null")
    30 local ubus_output = handle:read("*a")
    30 handle:close()


    30 local ubus_data = JSON.parse(ubus_output or "{}")

    30 local output_table = {}


    30 if ubus_data and ubus_data.device then

     6   for device_name, device_data in pairs(ubus_data.device) do
     3     if device_data and device_data.leases then

     9       for _, lease in ipairs(device_data.leases) do

     6         if lease.address and lease.mac then

     6           output_table[lease.address] = {
     6             hostname = lease.hostname or "", 
     6             mac = lease.mac
     6           }
               end
             end
           end
         end
       end


    30 local final_json_string = JSON.stringify(output_table)


    30 local pipe = io.popen("shared-state-async insert " .. CRDT, "w")
    30 if pipe then
    30   pipe:write(final_json_string)
    30   pipe:close()
       end


    30 os.execute("/usr/sbin/odhcpd-update >/dev/null 2>&1")

