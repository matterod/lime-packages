   832 				originator_value.neigh_address== originator_value.orig_address and  
   208 				originator_value.neigh_address== neight_value.dst_mac then
       					-- Batman "transmit link quality" (tq) is a byte that describes 
       					-- the probability of a successful transmission towards a
