    60     for line in io.lines(read_for_access.AUTH_MACS_FILE) do
    30         local words = {}
    90         for w in line:gmatch("%S+") do table.insert(words, w) end
    30         if tonumber(words[2]) > current_time then
    20             table.insert(result, words[1])
               end
           end
    30     return result
       end

