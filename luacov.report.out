  1120 function utils.set_root_secret(secret)
    20 	local f = io.open(utils.SHADOW_FILENAME, "r")
    20 	if f ~= nil then
       		--! perform a backup of the shadow
    20 		local f_bkp = io.open(utils.SHADOW_FILENAME .. "-", "w")
    20 		f_bkp:write(f:read("*a"))
    20 		f:seek("set")
    20 		f_bkp:close()

    20 		local root_line = f:read("*l") --! root user is always in the first line
    20 		local starts, ends = string.find(root_line, "root:.-:")
    20 		local content = "root:" .. secret .. root_line:sub(ends) .. "\n"
    20 		content = content .. f:read("*a")
    20 		f:close()
    20 		f = io.open(utils.SHADOW_FILENAME, "w")
    20 		f:write(content)
    20 		f:close()
       	end
       end

