       #!/usr/bin/lua

    30 local config = require 'lime.config'
    30 local wireless = require 'lime.wireless'
    30 local uci = config.get_uci_cursor()

    30 local uci_files = { config.UCI_COMMUNITY_NAME, config.UCI_NODE_NAME  }

       local function move_modes_to_specific_band(file_name)
    60     local modes = uci:get(file_name, 'wifi', 'modes')
    60     if modes == nil then
    30         return
           end
    30     local modes_2ghz = {}
    30     local modes_5ghz = {}
   110     for _, mode in pairs(modes) do
    80         local mode_name = utils.split(mode, '_')[1]
    80         local mode_band = utils.split(mode, '_')[2]
    80         if mode_band == nil or mode_band == '2ghz' then
    70             table.insert(modes_2ghz, mode_name)
               end
    80         if mode_band == nil or mode_band == '5ghz' then
    20             table.insert(modes_5ghz, mode_name)
               end
           end
    30     modes_2ghz = utils.tableLength(modes_2ghz) > 0 and modes_2ghz or {'manual'}
    30     modes_5ghz = utils.tableLength(modes_5ghz) > 0 and modes_5ghz or {'manual'}
    30     uci:set(file_name, '2ghz', 'lime-wifi-band')
    30     uci:set(file_name, '2ghz', 'modes', modes_2ghz)
    30     uci:set(file_name, '5ghz', 'lime-wifi-band')
    30     uci:set(file_name, '5ghz', 'modes', modes_5ghz)
    30     uci:delete(file_name, 'wifi', 'modes')
       end


       local function move_restof_to_specific_band(file_name)
    60     local options = uci:get_all(file_name, 'wifi')
    60     if options == nil then
*****0         return
           end
   270     for key, value in pairs(options) do
   210         local band_name = utils.split(key, '_')[2]
   210         if band_name == '2ghz' or band_name == '5ghz' then
    30             uci:set(file_name, band_name, 'lime-wifi-band')
    30             local derived_key = utils.split(key, '_')[1]
    30             uci:set(file_name, band_name, derived_key, value)
    30             uci:delete(file_name, 'wifi', key)
               end
           end
       end

       local function migrate_file(file_name)
    60     move_modes_to_specific_band(file_name)
    60     move_restof_to_specific_band(file_name)
    60     local changes = uci:changes()
    60     if utils.tableLength(changes) > 0 then
    60         uci:commit(file_name)
           end
       end

    90 for _, file_name in pairs(uci_files) do
    60     migrate_file(file_name)
       end

    30 print('migrate-wifi-modes: migration finished, now run lime-config')

