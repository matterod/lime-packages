    70 	local invalid = ipv4_template:equal(mc:network()) and "NETWORK"
       	--! If anygw enabled, generated address is the one reserved for anygw like 192.0.2.1/24 ?
    70 	if utils.isModuleAvailable("lime.proto.anygw") then
    20 		local generalProtocols = config.get("network", "protocols")
    40 		for _,protocol in pairs(generalProtocols) do
    20 			if protocol == 'anygw' then
*****0 				invalid = invalid or ipv4_template:equal(mc:minhost()) and "ANYGW"
