       end

    56 function location.set(lat, long)
    10     local uci = config.get_uci_cursor()
    10     uci:set("location", "settings", "node_latitude", lat)
    10     uci:set("location", "settings", "node_longitude", long)
    10     uci:commit("location")
    10     local hostname = system.get_hostname()
    10     local data = {}
    10     data[hostname] = location.nodes_and_links()
    10     io.popen("shared-state insert nodes_and_links", "w"):write(json.stringify(data))
       end

    56 function location.nodes_and_links()
    25   local hostname = io.input("/proc/sys/kernel/hostname"):read("*line")
    25   local macs = network.get_own_macs("wlan*")

    25   local coords = location.get_node() or location.get_community() or {lat="FIXME", long="FIXME"}
         local iface, currneigh, _, n

    25   local interfaces = wireless.mesh_ifaces()
    25   local links = {}
    35   for _, iface in pairs(interfaces) do
    10     currneigh = iwinfo.nl80211.assoclist(iface)
    15     for mac, station in pairs(currneigh) do
     5         table.insert(links, string.lower(mac))
           end
         end
    25   return {hostname=hostname, macs=macs, coordinates={lat=coords.lat, lon=coords.long}, links=links}
       end

    56 return location

