           else
*****0         return false, reason
           end
       end

    30 function pkg.disable(radio)
    10     local uci = config.get_uci_cursor()
    10     local radio = radio or pkg.DEFAULT_RADIO

    10     uci:delete(config.UCI_NODE_NAME, pkg.GENERIC_SECTION_NAME)
    10     uci:commit(config.UCI_NODE_NAME)
    10     uci:delete('system', 'hotspot_watchping')
    10     uci:commit('system')
    10     pkg._apply_change()
    10     return true
       end

    30 function pkg.status(radio)
    25     local uci = config.get_uci_cursor()
    25     local radio = radio or pkg.DEFAULT_RADIO
    25     local connected = false
           local signal

    25     local enabled = false

    25     if uci:get(config.UCI_NODE_NAME, pkg.GENERIC_SECTION_NAME) then
     5         enabled = true
           end

    30     for mac, station in pairs(iwinfo.nl80211.assoclist(pkg.IFACE_NAME)) do
     5         connected = true
     5         signal = station['signal']
           end

    25     return {connected = connected, signal = signal, enabled = enabled}
       end


    30 return pkg

